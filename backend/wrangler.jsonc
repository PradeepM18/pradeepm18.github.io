{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "pradeep-portfolio-chat",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "observability": {"enabled": false},
  "vars": {
    "ALLOWED_ORIGINS": "https://pradeepm18.github.io,https://pradeep-muniasamy.pradeepm1899.chatgpt.site"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "pradeep-portfolio-chat",
    "database_id": "REPLACE_WITH_CREATED_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "triggers": {"crons": ["15 2 * * *"]}
}
